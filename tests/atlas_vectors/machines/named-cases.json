          "needs": [
            "rom_stem"
          ]
        }
      }
    },
    {
      "name": "retrodeck-sort-by-content-and-core",
      "rationale": "Both sort flags on, with the content folder and core supplied: every hole but rom_stem is filled, yielding saves/<folder>/<core>.",
      "input": {
        "home": "/home/deck",
        "files": {
          "/home/deck/.var/app/net.retrodeck.retrodeck/config/retrodeck/retrodeck.json": "{\"paths\": {\"rd_home_path\": \"/mnt/sd/retrodeck\", \"saves_path\": \"/mnt/sd/retrodeck/saves\", \"roms_path\": \"/mnt/sd/retrodeck/roms\", \"bios_path\": \"/mnt/sd/retrodeck/bios\"}}",
          "/home/deck/.var/app/net.retrodeck.retrodeck/config/retroarch/retroarch.cfg": "sort_savefiles_by_content_enable = \"true\"\nsort_savefiles_enable = \"true\"\n"
        },
        "query": {
          "system": "gba",
          "core": "mgba_libretro",
          "rom_dir_name": "gba"
