    {
      "name": "standalone-flatpak-savefile-directory-set",
      "rationale": "The org.libretro.RetroArch Flatpak with savefile_directory set (with ~): the saves root is that expanded path, not a RetroDECK path.",
      "input": {
        "home": "/home/deck",
        "files": {
          "/home/deck/.var/app/org.libretro.RetroArch/config/retroarch/retroarch.cfg": "savefile_directory = \"~/RetroArch/saves\"\nsort_savefiles_by_content_enable = \"true\"\n"
        },
        "query": {
          "system": "gba"
        }
      },
      "expected": {
        "installations": [
          {
            "kind": "standalone_retroarch_flatpak",
            "root": "/home/deck/.var/app/org.libretro.RetroArch/config/retroarch"
          }
        ],
        "save_placement": {
          "dir": "/home/deck/RetroArch/saves/<content_dir>",
          "filename": "<rom_stem>.srm",
          "needs": [
            "content_dir",
            "rom_stem"
          ]
        }
