{
  "family": "machines",
  "spec": "DESIGN.md — Installations, placements, the reader seam",
  "description": "Fixture machines in, detected installations + save placements out. Each vector's input is a whole machine (a {path: content} file tree plus a home and an optional save-placement query); expected is the installations detect() finds and, when queried, the SavePlacement the highest-priority install returns. Save-placement expectations are oracle-derived: atlas's placement math is verified against decky-romm-sync's resolve_save_dir / compute_local_save_target.",
  "vectors": [
    {
      "name": "retrodeck-custom-home-sort-by-content",
      "rationale": "retrodeck.json present with a custom rd_home on an SD card; RetroArch sorts saves by content. The saves root comes from retrodeck.json, the content component is an unfilled hole.",
      "input": {
        "home": "/home/deck",
        "files": {
          "/home/deck/.var/app/net.retrodeck.retrodeck/config/retrodeck/retrodeck.json": "{\"paths\": {\"rd_home_path\": \"/mnt/sd/retrodeck\", \"saves_path\": \"/mnt/sd/retrodeck/saves\", \"roms_path\": \"/mnt/sd/retrodeck/roms\", \"bios_path\": \"/mnt/sd/retrodeck/bios\"}}",
          "/home/deck/.var/app/net.retrodeck.retrodeck/config/retroarch/retroarch.cfg": "sort_savefiles_by_content_enable = \"true\"\n"
        },
        "query": {
          "system": "gba"
        }
      },
      "expected": {
        "installations": [
          {
            "kind": "retrodeck",
            "root": "/mnt/sd/retrodeck"
          }
        ],
        "save_placement": {
          "dir": "/mnt/sd/retrodeck/saves/<content_dir>",
          "filename": "<rom_stem>.srm",
          "needs": [
            "content_dir",
            "rom_stem"
          ]
        }
      }
    },
    {
      "name": "retrodeck-fallback-home",
      "rationale": "retrodeck.json present but carries no paths; every root falls back to ~/retrodeck. Detection still succeeds — the file is the marker, its contents are best-effort.",
      "input": {
        "home": "/home/deck",
        "files": {
          "/home/deck/.var/app/net.retrodeck.retrodeck/config/retrodeck/retrodeck.json": "{}",
          "/home/deck/.var/app/net.retrodeck.retrodeck/config/retroarch/retroarch.cfg": "sort_savefiles_by_content_enable = \"true\"\n"
        },
        "query": {
          "system": "gba"
        }
      },
      "expected": {
        "installations": [
          {
            "kind": "retrodeck",
            "root": "/home/deck/retrodeck"
          }
        ],
        "save_placement": {
          "dir": "/home/deck/retrodeck/saves/<content_dir>",
          "filename": "<rom_stem>.srm",
          "needs": [
            "content_dir",
            "rom_stem"
          ]
        }
      }
    },
    {
      "name": "retrodeck-no-cfg-defaults",
      "rationale": "retrodeck.json present, no retroarch.cfg found: the layout falls to RetroDECK defaults (sort-by-content on, sort-by-core off). Provenance says 'default', not 'file'.",
      "input": {
        "home": "/home/deck",
        "files": {
          "/home/deck/.var/app/net.retrodeck.retrodeck/config/retrodeck/retrodeck.json": "{\"paths\": {\"rd_home_path\": \"/mnt/sd/retrodeck\", \"saves_path\": \"/mnt/sd/retrodeck/saves\", \"roms_path\": \"/mnt/sd/retrodeck/roms\", \"bios_path\": \"/mnt/sd/retrodeck/bios\"}}"
        },
        "query": {
          "system": "gba"
        }
      },
      "expected": {
        "installations": [
          {
            "kind": "retrodeck",
            "root": "/mnt/sd/retrodeck"
          }
        ],
        "save_placement": {
          "dir": "/mnt/sd/retrodeck/saves/<content_dir>",
          "filename": "<rom_stem>.srm",
          "needs": [
            "content_dir",
            "rom_stem"
          ]
        }
      }
    },
    {
      "name": "retrodeck-sort-disabled-flat",
      "rationale": "Both sort flags off: saves land flat in the saves root, no per-content or per-core subdir.",
      "input": {
        "home": "/home/deck",
        "files": {
          "/home/deck/.var/app/net.retrodeck.retrodeck/config/retrodeck/retrodeck.json": "{\"paths\": {\"rd_home_path\": \"/mnt/sd/retrodeck\", \"saves_path\": \"/mnt/sd/retrodeck/saves\", \"roms_path\": \"/mnt/sd/retrodeck/roms\", \"bios_path\": \"/mnt/sd/retrodeck/bios\"}}",
          "/home/deck/.var/app/net.retrodeck.retrodeck/config/retroarch/retroarch.cfg": "sort_savefiles_by_content_enable = \"false\"\nsort_savefiles_enable = \"false\"\n"
        },
        "query": {
          "system": "gba"
        }
      },
      "expected": {
        "installations": [
          {
            "kind": "retrodeck",
