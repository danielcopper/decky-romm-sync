    {
      "name": "retrodeck-savefiles-in-content-dir",
      "rationale": "savefiles_in_content_dir=true: the save lives next to the ROM, so the directory is the ROM's own folder — an unfilled <content_dir>, a valid placement, not an error.",
      "input": {
