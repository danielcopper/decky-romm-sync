{
  "family": "decision-table",
  "spec": "SPEC.md \u2014 Decision table (informative)",
  "description": "Named cases for the full per-(rom, filename, slot) decision of the reference model: branch selection (newest head by updated_at), the three device_syncs branches, the corrupt-local guard, both identity routes (parity AND provenance), and the timestamp fall-through. Curated, not exhaustive \u2014 the input space is unbounded. Hash strings and timestamps are placeholders; only presence, equality, and relative order carry meaning. Timestamps always carry an explicit UTC offset so parsing is environment-independent.",
  "vectors": [
    {
      "name": "no-server-saves-local-present",
      "rationale": "Nothing on the server side of the slot: a present local file is the only content \u2014 upload it as the first save.",
      "input": {
        "local_file": {
          "filename": "game.srm",
          "size": 8192,
          "mtime": 1780398000.0
        },
        "server_saves_in_slot": [],
        "files_state": {},
        "device_id": "device-a",
        "local_hash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expected": {
        "action": "upload",
        "target_save_id": null
      }
    },
    {
      "name": "no-server-saves-no-local",
      "rationale": "Neither side has anything for this file \u2014 nothing to sync.",
      "input": {
        "local_file": null,
        "server_saves_in_slot": [],
        "files_state": {},
        "device_id": "device-a",
        "local_hash": null
      },
      "expected": {
        "action": "skip",
        "reason": "nothing_to_sync",
        "adopt_baseline": false
      }
    },
    {
      "name": "entries-on-older-save-dont-count",
      "rationale": "This device is current on an OLDER save, but the decision branches on the NEWEST save's device_syncs only \u2014 no entry there, local absent, adopt the head.",
