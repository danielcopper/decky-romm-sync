        "local_file": null,
        "server_saves_in_slot": [
          {
            "id": 100,
            "updated_at": "2026-06-01T12:00:00Z",
            "content_hash": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            "device_syncs": [
