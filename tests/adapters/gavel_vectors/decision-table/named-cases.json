                "is_current": true
              }
            ]
          }
        ],
        "files_state": {
          "last_sync_hash": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          "last_sync_server_hash": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        },
        "device_id": "device-a",
        "local_hash": null
      },
      "expected": {
        "action": "download",
        "server_save_id": 101
      }
    },
    {
